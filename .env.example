# AirFM local server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=data/radio-agent.sqlite

# Claude CLI command. The default expects the Claude Code/CLI command to be available in PATH.
CLAUDE_COMMAND=claude
CLAUDE_ARGS=-p,--output-format,json

# NeteaseCloudMusicApi endpoint. Start it separately before running AirFM.
NETEASE_API_BASE=http://localhost:3001

# Optional fallback cookie. Prefer importing the cookie in the AirFM UI so it is stored in data/netease-session.json.
NETEASE_COOKIE=
NETEASE_SESSION_PATH=data/netease-session.json

# Fish Audio TTS. Both key and voice id are required for DJ voice playback.
FISH_API_KEY=
FISH_VOICE_ID=

# Optional network proxy for Fish Audio, only if your current device cannot reach api.fish.audio directly.
# Example format: http://127.0.0.1:7897
FISH_PROXY=

# Reserved for future weather integrations.
OPENWEATHER_API_KEY=
